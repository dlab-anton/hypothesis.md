# Hypothesis Engine API - Environment Variables
# Copy to .env and fill in your values. Do NOT commit .env.

# Database (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/hypothesis_engine"

# API Security - generate a random key before starting in any environment
API_MASTER_KEY="generate-a-random-key-here"

# Application
ENVIRONMENT="development"
PROJECT_NAME="HypothesisEngine API"
APP_VERSION="1.8.0"
CORS_ORIGINS=["http://localhost:3000"]
